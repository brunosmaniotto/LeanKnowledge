import Mathlib

open Set

variable {α : Type _}

/-- A collection of sets is a ring of sets if it contains the empty set and is closed under
finite unions and set differences. -/
structure IsRingOfSets (S : Set (Set α)) : Prop where
  empty_mem : ∅ ∈ S
  union_mem : ∀ A ∈ S, ∀ B ∈ S, A ∪ B ∈ S
  diff_mem : ∀ A ∈ S, ∀ B ∈ S, A \ B ∈ S

/-- The minimal ring generated by a collection `S` of sets. -/
def minimalRing (S : Set (Set α)) : Set (Set α) :=
  ⋂₀ {R : Set (Set α) | IsRingOfSets R ∧ S ⊆ R}