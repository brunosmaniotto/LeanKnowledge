import Mathlib

theorem Example_9_7 :
    -- U^VCG_1(1) = (1+5) - 10/9 = 44/9
    ((1 : ℝ) + 5 - 10/9) = (44/9 : ℝ) ∧
    -- ψ*_1 = 10 - U^VCG_1(1) = 46/9
    (10 - ((1 : ℝ) + 5 - 10/9)) = (46/9 : ℝ) ∧
    -- U^VCG_2(1) = 6 - 20/9 = 34/9
    (6 - (20/9 : ℝ)) = (34/9 : ℝ) ∧
    -- ψ*_2 = 0 - U^VCG_2(1) = -34/9
    (0 - (6 - (20/9 : ℝ))) = (-34/9 : ℝ) ∧
    -- ψ*_1 + ψ*_2 = 46/9 - 34/9 = 4/3
    (10 - ((1 : ℝ) + 5 - 10/9)) + (0 - (6 - (20/9 : ℝ))) = (4/3 : ℝ) ∧
    -- 50/27 > 4/3
    (50/27 : ℝ) > (4/3 : ℝ) := by
  norm_num